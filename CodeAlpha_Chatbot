# TASK 4: Basic Chatbot

def chatbot_reply(user_input):
    """Return chatbot responses based on user input."""
    user_input = user_input.lower()

    if "hello" in user_input or "hi" in user_input:
        return "Hi there! 👋"
    elif "how are you" in user_input:
        return "I'm doing great, thanks for asking! 😊"
    elif "name" in user_input:
        return "I'm your friendly Python chatbot 🤖"
    elif "bye" in user_input or "goodbye" in user_input:
        return "Goodbye! Have a great day! 👋"
    elif "thanks" in user_input or "thank you" in user_input:
        return "You're welcome! 😄"
    else:
        return "I'm sorry, I didn't understand that. Can you say it differently?"

# Main chatbot loop
print("🤖 Chatbot: Hello! Type 'bye' to end the chat.\n")

while True:
    user_message = input("You: ")
    reply = chatbot_reply(user_message)
    print("Chatbot:", reply)

    if "bye" in user_message.lower():
        break
